# Verified on Trigbotic; merge into that user's ~/.ssh/config.
# The private identity remains local to Trigbotic and is never deployed.
Host nebula-win-srv-01
    HostName 100.121.209.21
    User Administrator
    IdentityFile ~/.ssh/nebula_win_srv_01
    IdentitiesOnly yes
    ForwardAgent no
    StrictHostKeyChecking yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
